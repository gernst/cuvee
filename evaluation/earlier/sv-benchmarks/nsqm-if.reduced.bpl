data c#void = c#void;

type c#ptr<a₀>;

type c#heap;

function c#bitand(x₀: int, x₁: int): int;

function c#bitor(x₀: int, x₁: int): int;

goal (forall N₁₃: int, b: [int]int, b₁₄: [int]int, i₁₅: int, i₅: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₁₂₃: int ::
              (  0 <= i₁₂₃
                && i₁₂₃ < i₁₅
                 ==> i₁₂₃ == 0
                    && i₁₂₃ < N₁₃
                    && b₁₄[0] == 1
                  ||   (i₁₂₃ == 0
                       ==> false)
                    && i₁₂₃ < N₁₃
                    && b₁₄[i₁₂₃] == 2 + b[-1 + i₁₂₃]))
        && (forall i₁₂₄: int ::
                  0 <= i₁₂₄
                  && i₁₂₄ < i₁₅
                ||   b₁₄[0] == b[0]
                  && b₁₄[i₁₂₄] == b[i₁₂₄])
        && i₁₅ < N₁₃
        && i₁₅ == 0
         ==> 0 <= i₅
          || N₁₃ <= 0
          || b₁₄[0 := 1][0] == b[0]));

goal (forall N₁₃: int, b: [int]int, b₁₄: [int]int, i₁₅: int, i₅: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₁₃₅: int ::
              (  0 <= i₁₃₅
                && i₁₃₅ < i₁₅
                 ==> i₁₃₅ == 0
                    && i₁₃₅ < N₁₃
                    && b₁₄[0] == 1
                  ||   (i₁₃₅ == 0
                       ==> false)
                    && i₁₃₅ < N₁₃
                    && b₁₄[i₁₃₅] == 2 + b[-1 + i₁₃₅]))
        && (forall i₁₃₆: int ::
                  0 <= i₁₃₆
                  && i₁₃₆ < i₁₅
                ||   b₁₄[0] == b[0]
                  && b₁₄[i₁₃₆] == b[i₁₃₆])
        && i₁₅ < N₁₃
        && i₁₅ == 0
         ==> i₅ < i₁₅ + 1
          || N₁₃ <= 0
          || b₁₄[0 := 1][0] == b[0]));

goal (forall N₁₃: int, b: [int]int, b₁₄: [int]int, i₁₅: int, i₅: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₁₆₅: int ::
              (  0 <= i₁₆₅
                && i₁₆₅ < i₁₅
                 ==> i₁₆₅ == 0
                    && i₁₆₅ < N₁₃
                    && b₁₄[0] == 1
                  ||   (i₁₆₅ == 0
                       ==> false)
                    && i₁₆₅ < N₁₃
                    && b₁₄[i₁₆₅] == 2 + b[-1 + i₁₆₅]))
        && (forall i₁₆₆: int ::
                  0 <= i₁₆₆
                  && i₁₆₆ < i₁₅
                ||   b₁₄[0] == b[0]
                  && b₁₄[i₁₆₆] == b[i₁₆₆])
        && i₁₅ < N₁₃
        && 0 <= i₅
        && i₅ < i₁₅ + 1
         ==> i₁₅ == 0
          || N₁₃ <= 0
          || i₅ == 0
          || b₁₄[i₁₅ := b₁₄[i₁₅ - 1] + 2][i₅] == 2 + b[-1 + i₅]));

goal (forall N₁₃: int, a: [int]int, b: [int]int, b₁₄: [int]int, i₁₅: int, a₁₆: [int]int, i₁₇: int, i₈: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₅: int ::
              (  0 <= i₅
                && i₅ < i₁₅
                 ==> i₅ == 0
                    && i₅ < N₁₃
                    && b₁₄[0] == 1
                  ||   (i₅ == 0
                       ==> false)
                    && i₅ < N₁₃
                    && b₁₄[i₅] == 2 + b[-1 + i₅]))
        && (forall i₅: int ::
                  0 <= i₅
                  && i₅ < i₁₅
                ||   b₁₄[0] == b[0]
                  && b₁₄[i₅] == b[i₅])
        && 0 <= i₁₇
        && i₁₇ <= N₁₃
        && (forall i₃₉₃: int ::
              (  0 <= i₃₉₃
                && i₃₉₃ < i₁₇
                 ==> i₃₉₃ == 0
                    && i₃₉₃ < N₁₃
                    && a₁₆[0] == 1 + N₁₃
                  ||   (i₃₉₃ == 0
                       ==> false)
                    && i₃₉₃ < N₁₃
                    && a₁₆[i₃₉₃] == 2 + a[-1 + i₃₉₃] + b₁₄[-1 + i₃₉₃]))
        && (forall i₃₉₄: int ::
                  0 <= i₃₉₄
                  && i₃₉₄ < i₁₇
                ||   a₁₆[0] == a[0]
                  && a₁₆[i₃₉₄] == a[i₃₉₄])
        && i₁₇ < N₁₃
        && i₁₇ == 0
         ==> 0 <= i₈
          || i₁₅ < N₁₃
          || N₁₃ <= 0
          || a₁₆[0 := N₁₃ + 1][0] == a[0]));

goal (forall N₁₃: int, a: [int]int, b: [int]int, b₁₄: [int]int, i₁₅: int, a₁₆: [int]int, i₁₇: int, i₈: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₅: int ::
              (  0 <= i₅
                && i₅ < i₁₅
                 ==> i₅ == 0
                    && i₅ < N₁₃
                    && b₁₄[0] == 1
                  ||   (i₅ == 0
                       ==> false)
                    && i₅ < N₁₃
                    && b₁₄[i₅] == 2 + b[-1 + i₅]))
        && (forall i₅: int ::
