          || N₁₃ <= 0
          || a₁₆[0 := N₁₃ + 1][0] == a[0]));

goal (forall N₁₃: int, a: [int]int, b: [int]int, b₁₄: [int]int, i₁₅: int, a₁₆: [int]int, i₁₇: int, i₈: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₅: int ::
              (  0 <= i₅
                && i₅ < i₁₅
                 ==> i₅ == 0
                    && i₅ < N₁₃
                    && b₁₄[0] == 1
                  ||   (i₅ == 0
                       ==> false)
                    && i₅ < N₁₃
                    && b₁₄[i₅] == 2 + b[-1 + i₅]))
        && (forall i₅: int ::
                  0 <= i₅
                  && i₅ < i₁₅
                ||   b₁₄[0] == b[0]
                  && b₁₄[i₅] == b[i₅])
        && 0 <= i₁₇
        && i₁₇ <= N₁₃
        && (forall i₄₅₉: int ::
              (  0 <= i₄₅₉
                && i₄₅₉ < i₁₇
                 ==> i₄₅₉ == 0
                    && i₄₅₉ < N₁₃
                    && a₁₆[0] == 1 + N₁₃
                  ||   (i₄₅₉ == 0
                       ==> false)
                    && i₄₅₉ < N₁₃
                    && a₁₆[i₄₅₉] == 2 + a[-1 + i₄₅₉] + b₁₄[-1 + i₄₅₉]))
        && (forall i₄₆₀: int ::
                  0 <= i₄₆₀
                  && i₄₆₀ < i₁₇
                ||   a₁₆[0] == a[0]
                  && a₁₆[i₄₆₀] == a[i₄₆₀])
        && i₁₇ < N₁₃
        && 0 <= i₈
        && i₈ < i₁₇ + 1
         ==> i₁₇ == 0
          || i₁₅ < N₁₃
          || N₁₃ <= 0
          || i₈ == 0
          || a₁₆[i₁₇ := a₁₆[i₁₇ - 1] + b₁₄[i₁₇ - 1] + 2][i₈] == 2 + a[-1 + i₈] + b₁₄[-1 + i₈]));

goal (forall N₁₃: int, a: [int]int, b: [int]int, b₁₄: [int]int, i₁₅: int, a₁₆: [int]int, i₁₇: int, i₁₈: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₅: int ::
              (  0 <= i₅
                && i₅ < i₁₅
                 ==> i₅ == 0
                    && i₅ < N₁₃
                    && b₁₄[0] == 1
                  ||   (i₅ == 0
                       ==> false)
                    && i₅ < N₁₃
                    && b₁₄[i₅] == 2 + b[-1 + i₅]))
        && (forall i₅: int ::
                  0 <= i₅
                  && i₅ < i₁₅
                ||   b₁₄[0] == b[0]
                  && b₁₄[i₅] == b[i₅])
        && 0 <= i₁₇
        && i₁₇ <= N₁₃
        && (forall i₈: int ::
              (  0 <= i₈
                && i₈ < i₁₇
                 ==> i₈ == 0
                    && i₈ < N₁₃
                    && a₁₆[0] == 1 + N₁₃
                  ||   (i₈ == 0
                       ==> false)
                    && i₈ < N₁₃
                    && a₁₆[i₈] == 2 + a[-1 + i₈] + b₁₄[-1 + i₈]))
        && (forall i₈: int ::
                  0 <= i₈
                  && i₈ < i₁₇
                ||   a₁₆[0] == a[0]
                  && a₁₆[i₈] == a[i₈])
        && 0 <= i₁₈
        && i₁₈ <= N₁₃
        && (forall i₁₁: int ::
              (  0 <= i₁₁
                && i₁₁ < i₁₈
                 ==> i₁₁ < N₁₃))
        && i₁₈ < N₁₃
         ==> i₁₇ < N₁₃
          || i₁₅ < N₁₃
          || N₁₃ <= 0
          || a₁₆[i₁₈] == N₁₃ + (i₁₈ + 1) * (i₁₈ + 1)));

