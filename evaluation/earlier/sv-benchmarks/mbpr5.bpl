var CELLCOUNT: int;

goal (forall CELLCOUNT₂₆: int ::
      (forall volArray: [int]int ::
            (1 < CELLCOUNT₂₆
               ==> (CELLCOUNT₂₆ % 5 == 0
                 ==> (CELLCOUNT₂₆ % 5 == 0
                   ==> 1 <= 1
                    && 1 <= 1 + CELLCOUNT₂₆ / 5
                    && (forall x₅: int, i₄: int ::
                          (  (x₅ == -1 + 5 * i₄
                               ==> 1 <= i₄
                                && i₄ < 1)
                            &&   x₅ == -1 + 5 * i₄
                              ||   x₅ == -2 + 5 * i₄
                                && 1 <= i₄
                                && i₄ < 1
                              || (x₅ == -2 + 5 * i₄
                                 ==> false)
                             ==> (exists i₄: int ::
                                      2 <= 8
                                      && i₄ <= CELLCOUNT₂₆ / 5
                                      && if(x₅ == -1 + 5 * i₄) then 1 <= i₄ && i₄ < 1 && volArray[x₅] == volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄]][-3 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄]][-3 + 5 * i₄]][-2 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄]][-3 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄]][-3 + 5 * i₄]][-2 + 5 * i₄]][-1 + 5 * i₄] else if(x₅ == -2 + 5 * i₄) then 1 <= i₄ && i₄ < 1 && volArray[x₅] == volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄]][-3 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄]][-3 + 5 * i₄]][-2 + 5 * i₄] else if(x₅ == -3 + 5 * i₄) then 1 <= i₄ && i₄ < 1 && volArray[x₅] == volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄ := volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄]][-3 + 5 * i₄] else if(x₅ == -4 + 5 * i₄) then 1 <= i₄ && i₄ < 1 && volArray[x₅] == volArray[-5 + 5 * i₄ := 8][-4 + 5 * i₄] else x₅ == -5 + 5 * i₄ && 1 <= i₄ && i₄ < 1 && volArray[x₅] == 8)
                              || (2 <= 8
                                 ==> false)))
                    && (forall x₅: int ::
                            (exists i₄: int ::
                                  if(x₅ == -1 + 5 * i₄) then 1 <= i₄ && i₄ < 1 else if(x₅ == -2 + 5 * i₄) then 1 <= i₄ && i₄ < 1 else if(x₅ == -3 + 5 * i₄) then 1 <= i₄ && i₄ < 1 else if(x₅ == -4 + 5 * i₄) then 1 <= i₄ && i₄ < 1 else x₅ == -5 + 5 * i₄ && 1 <= i₄ && i₄ < 1)
                            || volArray[x₅] == volArray[x₅])
                    && (forall i₄: int ::
                          (  1 <= i₄
                            && i₄ < 1
                             ==> i₄ <= CELLCOUNT₂₆ / 5))
                    && (forall volArray₂₇: [int]int, i₂₈: int ::
                          (  1 <= i₂₈
                            && i₂₈ <= 1 + CELLCOUNT₂₆ / 5
                            && (forall x₅: int, i₄: int ::
                                  (  (x₅ == -1 + 5 * i₄
                                       ==> 1 <= i₄
                                        && i₄ < i₂₈)
                                    &&   x₅ == -1 + 5 * i₄
                                      ||   x₅ == -2 + 5 * i₄
                                        && 1 <= i₄
                                        && i₄ < i₂₈
