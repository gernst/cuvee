goal (forall N₁₃: int, a: [int]int, b: [int]int, a₁₄: [int]int, i₁₅: int, b₁₆: [int]int, i₁₇: int, i₈: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₅: int ::
              (  0 <= i₅
                && i₅ < i₁₅
                 ==> i₅ == 0
                    && i₅ < N₁₃
                    && a₁₄[0] == 4
                  ||   (i₅ == 0
                       ==> false)
                    && i₅ < N₁₃
                    && a₁₄[i₅] == 4 + a[-1 + i₅]))
        && (forall i₅: int ::
                  0 <= i₅
                  && i₅ < i₁₅
                ||   a₁₄[0] == a[0]
                  && a₁₄[i₅] == a[i₅])
        && 0 <= i₁₇
        && i₁₇ <= N₁₃
        && (forall i₄₅₉: int ::
              (  0 <= i₄₅₉
                && i₄₅₉ < i₁₇
                 ==> i₄₅₉ == 0
                    && i₄₅₉ < N₁₃
                    && b₁₆[0] == 1
                  ||   (i₄₅₉ == 0
                       ==> false)
                    && i₄₅₉ < N₁₃
                    && b₁₆[i₄₅₉] == b[-1 + i₄₅₉] + a₁₄[-1 + i₄₅₉]))
        && (forall i₄₆₀: int ::
                  0 <= i₄₆₀
                  && i₄₆₀ < i₁₇
                ||   b₁₆[0] == b[0]
                  && b₁₆[i₄₆₀] == b[i₄₆₀])
        && i₁₇ < N₁₃
        && 0 <= i₈
        && i₈ < i₁₇ + 1
         ==> i₁₇ == 0
          || i₁₅ < N₁₃
          || N₁₃ <= 0
          || i₈ == 0
          || b₁₆[i₁₇ := b₁₆[i₁₇ - 1] + a₁₄[i₁₇ - 1]][i₈] == b[-1 + i₈] + a₁₄[-1 + i₈]));

goal (forall N₁₃: int, a: [int]int, b: [int]int, a₁₄: [int]int, i₁₅: int, b₁₆: [int]int, i₁₇: int, i₁₈: int ::
      (  N₁₃ <= 2147483647 / 4
        && 0 <= i₁₅
        && i₁₅ <= N₁₃
        && (forall i₅: int ::
              (  0 <= i₅
                && i₅ < i₁₅
                 ==> i₅ == 0
                    && i₅ < N₁₃
                    && a₁₄[0] == 4
                  ||   (i₅ == 0
                       ==> false)
                    && i₅ < N₁₃
                    && a₁₄[i₅] == 4 + a[-1 + i₅]))
        && (forall i₅: int ::
                  0 <= i₅
                  && i₅ < i₁₅
                ||   a₁₄[0] == a[0]
                  && a₁₄[i₅] == a[i₅])
        && 0 <= i₁₇
        && i₁₇ <= N₁₃
        && (forall i₈: int ::
              (  0 <= i₈
                && i₈ < i₁₇
                 ==> i₈ == 0
                    && i₈ < N₁₃
                    && b₁₆[0] == 1
                  ||   (i₈ == 0
                       ==> false)
                    && i₈ < N₁₃
                    && b₁₆[i₈] == b[-1 + i₈] + a₁₄[-1 + i₈]))
        && (forall i₈: int ::
                  0 <= i₈
                  && i₈ < i₁₇
                ||   b₁₆[0] == b[0]
                  && b₁₆[i₈] == b[i₈])
        && 0 <= i₁₈
        && i₁₈ <= N₁₃
        && (forall i₁₁: int ::
              (  0 <= i₁₁
                && i₁₁ < i₁₈
                 ==> i₁₁ < N₁₃))
        && i₁₈ < N₁₃
         ==> i₁₇ < N₁₃
          || i₁₅ < N₁₃
          || N₁₃ <= 0
          || b₁₆[i₁₈] == 2 * i₁₈ * i₁₈ + 2 * i₁₈ + 1));

