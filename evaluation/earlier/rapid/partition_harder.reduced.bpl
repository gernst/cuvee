                  ||   (a[i₄₅₄] >= 0
                       ==> false)
                    && i₄₅₄ < alength
                    && c₁₃[clength₄₅₅] == a[i₄₅₄]))
        && (forall clength₄₅₈: int, i₄₅₇: int, blength₄₅₆: int ::
