                  ||   b₁₁[blength₄₅₆] == b[blength₄₅₆]
                    && c₁₃[clength₄₅₈] == c[clength₄₅₈]))
        && i₁₀ < alength
        && clength₁ + clength₁ == i₂ + i₂
        && clength₁ + clength₁ == blength₃ + blength₃
         ==> i₂ < i₁₀ + 1
