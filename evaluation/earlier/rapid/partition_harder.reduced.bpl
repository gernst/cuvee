                 ==> a[i₅₀₈] >= 0
                    && i₅₀₈ < alength
                    && b₁₁[blength₅₀₇] == a[i₅₀₈]
                  ||   (a[i₅₀₈] >= 0
                       ==> false)
                    && i₅₀₈ < alength
